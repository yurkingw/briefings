{% import "macros.njk" as ui with context %}
{% set isDaily = briefing.date %}
{% set news = briefing.news if briefing.news else [] %}
{% set decisions = briefing.decisions if briefing.decisions else [] %}
{% set gh = briefing.github if briefing.github else {} %}
{% set ghSummary = gh.meta | githubSummary if gh.meta else [] %}
{% set showGithub = (gh.rising and gh.rising.length) or (gh.newcomers and gh.newcomers.length) or ghSummary.length %}
{% set showPapers = briefing.papers and briefing.papers.length %}
{% set split = briefing | hasWaveSplit %}
{% set morningNews = news | waveItems("morning") %}
{% set afternoonNews = news | waveItems("afternoon") %}
{% set defaultWave = briefing | defaultWave %}
{% set props = briefing | pagePropertyRows %}
{% set windowText = briefing | papersWindow %}
{% set steps = decisions | saSteps %}
{% set judgments = decisions | finalJudgments %}
{% set polfin = briefing.polfin if briefing.polfin else [] %}
{% set polfinMorning = polfin | waveItems("morning") %}
{% set polfinAfternoon = polfin | waveItems("afternoon") %}
{% set polfinDefault = { news: polfin, wave: briefing.wave } | defaultWave %}
{% set paperCap = 5 if isDaily else 6 %}
{% set paperLead = briefing.papers | takeFeatured(paperCap) if briefing.papers else [] %}
{% set paperRest = briefing.papers | takeRest(paperCap) if briefing.papers else [] %}

<div class="sheet">
<div class="page-head">
  <p class="kicker">
    {% if isDaily %}Daily · {{ briefing.date }}{% else %}Weekly · {{ briefing.week }}{% endif %}
    · {{ briefing.timezone }}
    {% if briefing.sample %} · <span class="sample">Sample</span>{% endif %}
  </p>
  <h1>{% if isDaily %}{{ labels.dailyBriefing }} · {{ briefing.date }}{% else %}{{ labels.weeklyBriefing }} · {{ briefing.week }}{% endif %}</h1>
  <p class="updated">Updated <time datetime="{{ briefing.updated_at }}">{{ briefing.updated_at }}</time>{% if briefing.wave %} · Wave <span lang="zh-Hans">{{ briefing.wave }}</span>{% endif %}</p>
  {% if briefing.sample_note %}
  <p class="scope" lang="zh-Hans">{{ briefing.sample_note }}</p>
  {% endif %}
</div>

<dl class="brf-properties" id="metrics">
  {%- for row in props %}
  <div class="brf-properties-row">
    <dt>{{ row.label }}</dt>
    <dd{% if row.value | textLang %} lang="zh-Hans"{% endif %}>{{ row.value }}</dd>
  </div>
  {%- endfor %}
</dl>

<section class="block mainline" id="conclusion">
  <h2>{% if isDaily %}{{ labels.today }}{% else %}{{ labels.thisWeek }}{% endif %}</h2>
  {{ ui.callout(labels.summary, briefing.summary, "warning", "zh-Hans") }}
</section>
</div>

<section class="columns sheet" id="page-top">
  <h2>{{ labels.sections }}</h2>
  {{ ui.columnTabs(isDaily, "") }}

  <section class="page-panel" id="panel-news" role="tabpanel" aria-labelledby="tab-news" tabindex="0">
    {% if isDaily and split %}
    <div class="sub-tabs seg" role="tablist" aria-label="{{ labels.wave }}">
      <button type="button" role="tab" id="tab-morning" aria-controls="wave-morning" aria-selected="{{ "true" if defaultWave == "morning" else "false" }}" tabindex="{{ "0" if defaultWave == "morning" else "-1" }}">{{ labels.morning }}</button>
      <span class="seg-gap" aria-hidden="true">·</span>
      <button type="button" role="tab" id="tab-afternoon" aria-controls="wave-afternoon" aria-selected="{{ "true" if defaultWave == "afternoon" else "false" }}" tabindex="{{ "0" if defaultWave == "afternoon" else "-1" }}">{{ labels.afternoon }}</button>
    </div>
    <div class="sub-panel" id="wave-morning" role="tabpanel" aria-labelledby="tab-morning"{% if defaultWave != "morning" %} hidden inert{% endif %}>
      {{ ui.newsDaily(morningNews, defaultWave == "morning", "morning") }}
    </div>
    <div class="sub-panel" id="wave-afternoon" role="tabpanel" aria-labelledby="tab-afternoon"{% if defaultWave != "afternoon" %} hidden inert{% endif %}>
      {{ ui.newsDaily(afternoonNews, defaultWave == "afternoon", "afternoon") }}
    </div>
    {% elif isDaily %}
    {{ ui.newsDaily(news, true, "news") }}
    {% else %}
    <div id="weekly-news">
      {% if briefing.news_digest %}
      {{ ui.callout(labels.thisWeek, briefing.news_digest, "info", "zh-Hans") }}
      {% endif %}
      {% if news.length %}
      {% set newsLead = news | takeFeatured(10) %}
      {% set newsRest = news | takeRest(10) %}
      <section class="block hot-picks" id="weekly-news-hot">
        <h2>{{ labels.thisWeek }}</h2>
        <ol class="hot hot-list">
          {% for item in newsLead %}
          <li><a class="hot-jump hit-row" href="#note-{{ item.id }}"><span class="hot-index">{{ loop.index }}</span><span class="hot-title" lang="zh-Hans">{{ item | displayTitle }}</span></a></li>
          {% endfor %}
        </ol>
      </section>
      <div class="detail-cards">
        {% for item in newsLead %}
        {{ ui.detailCard(item) }}
        {% endfor %}
      </div>
      {% if newsRest.length %}
      <section class="block" id="weekly-news-rest">
        <h2>{{ labels.otherPoints }}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">{{ labels.domain }}</th>
                <th scope="col">{{ labels.title }}</th>
                <th scope="col">{{ labels.channel }}</th>
                <th scope="col">{{ labels.firstSeen }}</th>
                <th scope="col">{{ labels.links }}</th>
              </tr>
            </thead>
            <tbody>
              {% for item in newsRest %}
              <tr id="feature-{{ item.id }}">
                <td data-label="#">{{ loop.index }}</td>
                <td data-label="{{ labels.domain }}"{% if item.domain | textLang %} lang="zh-Hans"{% endif %}>{{ item.domain }}</td>
                <td class="col-title" data-label="{{ labels.title }}"{% if item | displayTitle | textLang %} lang="zh-Hans"{% endif %}><span class="cell-short is-title">{{ item | displayTitle }}</span></td>
                <td data-label="{{ labels.channel }}"{% if item.channel | textLang %} lang="zh-Hans"{% endif %}>{% if item.channel %}{{ item.channel }}{% else %}—{% endif %}</td>
                <td data-label="{{ labels.firstSeen }}"{% if item.first_source_at | textLang %} lang="zh-Hans"{% endif %}>{% if item.first_source_at %}{{ item.first_source_at }}{% else %}—{% endif %}</td>
                <td data-label="{{ labels.links }}">{{ ui.cellLinks(item.links) }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
      {% endif %}
      {% else %}
      {{ ui.callout(labels.status, labels.noEntries, "info") }}
      {% endif %}
      {% if briefing.sources and briefing.sources.length %}
      <section class="block" id="sources">
        <h2>{{ labels.sources }}</h2>
        {{ ui.linkCards(briefing.sources) }}
      </section>
      {% endif %}
    </div>
    {% endif %}
  </section>

  <section class="page-panel" id="panel-polfin" role="tabpanel" aria-labelledby="tab-polfin" hidden inert>
    {% if isDaily %}
    {% if not polfin.length %}
    <p class="empty">{{ labels.noEntries }}</p>
    {% endif %}
    <div class="sub-tabs seg" role="tablist" aria-label="{{ labels.wave }}">
      <button type="button" role="tab" id="tab-pf-morning" data-tab="morning" aria-controls="pf-wave-morning" aria-selected="{{ "true" if polfinDefault == "morning" else "false" }}" tabindex="{{ "0" if polfinDefault == "morning" else "-1" }}">{{ labels.morning }}</button>
      <span class="seg-gap" aria-hidden="true">·</span>
      <button type="button" role="tab" id="tab-pf-afternoon" data-tab="afternoon" aria-controls="pf-wave-afternoon" aria-selected="{{ "true" if polfinDefault == "afternoon" else "false" }}" tabindex="{{ "0" if polfinDefault == "afternoon" else "-1" }}">{{ labels.afternoon }}</button>
    </div>
    <div class="sub-panel" id="pf-wave-morning" role="tabpanel" aria-labelledby="tab-pf-morning"{% if polfinDefault != "morning" %} hidden inert{% endif %}>
      {{ ui.newsDaily(polfinMorning, false, "polfin-morning", "polfin") }}
    </div>
    <div class="sub-panel" id="pf-wave-afternoon" role="tabpanel" aria-labelledby="tab-pf-afternoon"{% if polfinDefault != "afternoon" %} hidden inert{% endif %}>
      {{ ui.newsDaily(polfinAfternoon, false, "polfin-afternoon", "polfin") }}
    </div>
    {% elif polfin.length %}
    {% set pfLead = polfin | takeFeatured(10) %}
    {% set pfRest = polfin | takeRest(10) %}
    <section class="block hot-picks" id="polfin-hot">
      <h2>{{ labels.thisWeek }}</h2>
      <ol class="hot hot-list">
        {% for item in pfLead %}
        <li><a class="hot-jump hit-row" href="#note-{{ item.id }}"><span class="hot-index">{{ loop.index }}</span><span class="hot-title" lang="zh-Hans">{{ item | displayTitle }}</span></a></li>
        {% endfor %}
      </ol>
    </section>
    <div class="detail-cards">
      {% for item in pfLead %}
      {{ ui.detailCard(item) }}
      {% endfor %}
    </div>
    {% if pfRest.length %}
    <section class="block" id="polfin-rest">
      <h2>{{ labels.otherPoints }}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">{{ labels.angle }}</th>
              <th scope="col">{{ labels.title }}</th>
              <th scope="col">{{ labels.channel }}</th>
              <th scope="col">{{ labels.firstSeen }}</th>
              <th scope="col">{{ labels.links }}</th>
            </tr>
          </thead>
          <tbody>
            {% for item in pfRest %}
            <tr>
              <td data-label="#">{{ item.id }}</td>
              <td data-label="{{ labels.angle }}"{% if item | itemKicker | textLang %} lang="zh-Hans"{% endif %}>{{ item | itemKicker }}</td>
              <td class="col-title" data-label="{{ labels.title }}"{% if item | displayTitle | textLang %} lang="zh-Hans"{% endif %}><span class="cell-short is-title">{{ item | displayTitle }}</span></td>
              <td data-label="{{ labels.channel }}"{% if item.channel | textLang %} lang="zh-Hans"{% endif %}>{% if item.channel %}{{ item.channel }}{% else %}—{% endif %}</td>
              <td data-label="{{ labels.firstSeen }}"{% if item.first_source_at | textLang %} lang="zh-Hans"{% endif %}>{% if item.first_source_at %}{{ item.first_source_at }}{% else %}—{% endif %}</td>
              <td data-label="{{ labels.links }}">{{ ui.cellLinks(item.links) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}
    {% else %}
    {{ ui.callout(labels.status, labels.noEntries, "info") }}
    {% endif %}
  </section>

  <section class="page-panel" id="panel-papers" role="tabpanel" aria-labelledby="tab-papers" hidden inert>
    {% if showPapers %}
    {% if windowText %}{{ ui.callout(labels.today if isDaily else labels.thisWeek, windowText, "info") }}{% endif %}
    {% if paperLead.length %}
    <section class="block hot-picks" id="papers-hot">
      <h2>{{ labels.read }}</h2>
      <ol class="hot hot-list">
        {% for paper in paperLead %}
        <li><a class="hot-jump hit-row" href="#paper-{{ loop.index }}"><span class="hot-index">{{ loop.index }}</span><span class="hot-title cell-short" title="{{ paper.short }}">{{ paper.short }}</span></a></li>
        {% endfor %}
      </ol>
    </section>
    <div class="paper-cards">
      {% for paper in paperLead %}
      {% set fields = paper | paperFields %}
      <article class="paper-card" id="paper-{{ loop.index }}">
        <h3 class="card-title" title="{{ paper.short }}">#{{ loop.index }} · <span class="cell-short">{{ paper.short }}</span></h3>
        <dl class="brf-properties">
          <div class="brf-properties-row"><dt>{{ labels.what }}</dt><dd{% if fields.grabbed | textLang %} lang="zh-Hans"{% endif %}>{{ fields.grabbed }}</dd></div>
          <div class="brf-properties-row"><dt>{{ labels.points }}</dt><dd{% if fields.points | textLang %} lang="zh-Hans"{% endif %}>{{ fields.points }}</dd></div>
          <div class="brf-properties-row"><dt>{{ labels.whyRead }}</dt><dd{% if fields.why | textLang %} lang="zh-Hans"{% endif %}>{{ fields.why }}</dd></div>
          <div class="brf-properties-row"><dt>{{ labels.links }}</dt><dd>
            {% for view in paper | paperLinkList %}
            <a class="{{ "paper-dair" if view.label == "DAIR" else "paper-main" }}" href="{{ view.href }}" title="{{ view.title }}" target="_blank" rel="noopener noreferrer">{{ view.label }}</a>
            {% endfor %}
          </dd></div>
        </dl>
      </article>
      {% endfor %}
    </div>
    {% endif %}
    {% if paperRest.length %}
    <section class="block" id="papers-rest">
      <h2>{{ labels.otherPapers }}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">{{ labels.shortName }}</th>
              <th scope="col">{{ labels.what }}</th>
              <th scope="col">{{ labels.whyRead }}</th>
              <th scope="col">{{ labels.links }}</th>
            </tr>
          </thead>
          <tbody>
            {% for paper in paperRest %}
            <tr>
              <td data-label="#">{{ loop.index }}</td>
              <td class="col-short" data-label="{{ labels.shortName }}"{% if paper.short | textLang %} lang="zh-Hans"{% endif %}><span class="cell-short" title="{{ paper.short }}">{{ paper.short }}</span></td>
              <td data-label="{{ labels.what }}"{% if paper.what | textLang %} lang="zh-Hans"{% endif %}>{% if paper.what %}{{ paper.what }}{% else %}—{% endif %}</td>
              <td data-label="{{ labels.whyRead }}"{% if paper.why | textLang %} lang="zh-Hans"{% endif %}>{% if paper.why %}{{ paper.why }}{% else %}—{% endif %}</td>
              <td data-label="{{ labels.links }}">{{ ui.cellLinks(paper | paperLinkList) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}
    {% else %}
    {{ ui.callout(labels.status, labels.noEntries, "info") }}
    {% endif %}
  </section>

  <section class="page-panel" id="panel-github" role="tabpanel" aria-labelledby="tab-github" hidden inert>
    {% if showGithub %}
    {% include "github.njk" %}
    {% else %}
    {{ ui.callout(labels.status, labels.noEntries, "info") }}
    {% endif %}
  </section>

  {% if isDaily %}
  <section class="page-panel" id="panel-appendix" role="tabpanel" aria-labelledby="tab-appendix" hidden inert>
    {% if news.length %}
    <h2>{{ labels.dayTotal }}</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">{{ labels.section }}</th>
            <th scope="col">{{ labels.domain }}</th>
            <th scope="col">{{ labels.title }}</th>
            <th scope="col">{{ labels.wave }}</th>
            <th scope="col">{{ labels.channel }}</th>
            <th scope="col">finsec</th>
            <th scope="col">{{ labels.links }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in news %}
          <tr>
            <td data-label="#">{{ item.id }}</td>
            <td data-label="{{ labels.section }}">{{ labels.news }}</td>
            <td data-label="{{ labels.domain }}"{% if item.domain | textLang %} lang="zh-Hans"{% endif %}>{{ item.domain }}</td>
            <td class="col-title" data-label="{{ labels.title }}"{% if item | displayTitle | textLang %} lang="zh-Hans"{% endif %}>
              <span class="cell-short is-title">{{ item | displayTitle }}</span>
              {% if item.hard_gate === true %}<span class="brf-status-row"><span class="brf-status" data-tone="danger">{{ labels.hardGate }}</span></span>{% endif %}
            </td>
            <td data-label="{{ labels.wave }}"{% if item.wave | textLang %} lang="zh-Hans"{% endif %}>{% if item.wave %}{{ item.wave }}{% else %}—{% endif %}</td>
            <td data-label="{{ labels.channel }}"{% if item.channel | textLang %} lang="zh-Hans"{% endif %}>{% if item.channel %}{{ item.channel }}{% else %}—{% endif %}</td>
            <td data-label="finsec">{% if item.finsec === true %}<span class="brf-status">finsec</span>{% else %}—{% endif %}</td>
            <td data-label="{{ labels.links }}">{{ ui.cellLinks(item.links) }}</td>
          </tr>
          {% endfor %}
          {% for item in polfin %}
          <tr>
            <td data-label="#">{{ item.id }}</td>
            <td data-label="{{ labels.section }}">{{ labels.polfin }}</td>
            <td data-label="{{ labels.domain }}"{% if item | itemKicker | textLang %} lang="zh-Hans"{% endif %}>{{ item | itemKicker }}</td>
            <td class="col-title" data-label="{{ labels.title }}"{% if item | displayTitle | textLang %} lang="zh-Hans"{% endif %}><span class="cell-short is-title">{{ item | displayTitle }}</span></td>
            <td data-label="{{ labels.wave }}"{% if item.wave | textLang %} lang="zh-Hans"{% endif %}>{% if item.wave %}{{ item.wave }}{% else %}—{% endif %}</td>
            <td data-label="{{ labels.channel }}"{% if item.channel | textLang %} lang="zh-Hans"{% endif %}>{% if item.channel %}{{ item.channel }}{% else %}—{% endif %}</td>
            <td data-label="finsec">{% if item.finsec === true or item.hard_gate === true %}<span class="brf-status">finsec</span>{% else %}—{% endif %}</td>
            <td data-label="{{ labels.links }}">{{ ui.cellLinks(item.links) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="empty">{{ labels.noEntries }}</p>
    {% endif %}
  </section>
  {% else %}
  <section class="page-panel" id="panel-decisions" role="tabpanel" aria-labelledby="tab-decisions" hidden inert>
    {% if decisions.length %}
    {{ ui.callout(labels.hardGate, briefing | financeLead, "danger", "zh-Hans") }}
    {% for card in decisions %}
    <article class="decision" id="decision-{{ loop.index }}">
      <h3{% if card.title | textLang %} lang="zh-Hans"{% endif %}>{{ loop.index }}. {{ card.title }}</h3>
      <dl class="brf-properties">
        <div class="brf-properties-row"><dt>{{ labels.facts }}</dt><dd{% if card.happened | textLang %} lang="zh-Hans"{% endif %}>{% if card.happened %}{{ card.happened }}{% else %}—{% endif %}</dd></div>
        <div class="brf-properties-row"><dt>{{ labels.judgment }}</dt><dd{% if card.judgment and card.judgment.length and card.judgment | join("") | textLang %} lang="zh-Hans"{% endif %}>{% if card.judgment and card.judgment.length %}{{ card.judgment | join("; ") }}{% else %}—{% endif %}</dd></div>
        <div class="brf-properties-row"><dt>{{ labels.whyItMatters }}</dt><dd{% if card.why | textLang %} lang="zh-Hans"{% endif %}>{% if card.why %}{{ card.why }}{% else %}—{% endif %}</dd></div>
        <div class="brf-properties-row"><dt>{{ labels.architectureImpact }}</dt><dd{% if card.arch_impact | textLang %} lang="zh-Hans"{% endif %}>{% if card.arch_impact %}{{ card.arch_impact }}{% else %}—{% endif %}</dd></div>
        <div class="brf-properties-row"><dt>{{ labels.controlDomains }}</dt><dd{% if card.control_domains and card.control_domains.length and card.control_domains | join("") | textLang %} lang="zh-Hans"{% endif %}>{% if card.control_domains and card.control_domains.length %}{{ card.control_domains | join(", ") }}{% else %}—{% endif %}</dd></div>
        <div class="brf-properties-row"><dt>{{ labels.costTradeoff }}</dt><dd>—</dd></div>
      </dl>
    </article>
    {% endfor %}
    {% if steps.length %}
    <section class="block" id="sa-steps">
      <h2>{{ labels.saActions }}</h2>
      <ol class="brf-steps">
        {% for step in steps %}
        <li class="brf-step">
          <span class="brf-step-lead">{{ loop.index }}</span>
          <div>
            <p class="brf-step-title" lang="zh-Hans">{{ step.level }} · {{ step.title }}</p>
            {% if step.detail %}<p class="brf-step-detail" lang="zh-Hans">{{ step.detail }}</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}
    {% if judgments.length %}
    <section class="block" id="final-judgment">
      <h2>{{ labels.finalJudgment }}</h2>
      <ol class="final-judgment" lang="zh-Hans">
        {% for line in judgments %}<li>{{ line }}</li>{% endfor %}
      </ol>
    </section>
    {% endif %}
    {% else %}
    {{ ui.callout(labels.status, labels.noEntries, "info") }}
    {% endif %}
  </section>
  {% endif %}

  {% if isDaily and briefing.sources and briefing.sources.length %}
  <section class="block" id="sources">
    <h2>{{ labels.sources }}</h2>
    {{ ui.linkCards(briefing.sources) }}
  </section>
  {% endif %}

  {{ ui.columnTabs(isDaily, "-end") }}
</section>
