<h2>GitHub notes</h2>
{% set meta = briefing.github.meta %}
{% if meta %}
<ul>
  {% if meta.archive %}<li>Archive: {{ meta.archive }}</li>{% endif %}
  {% if meta.archive_note %}<li lang="zh-Hans">{{ meta.archive_note }}</li>{% endif %}
  {% if meta.note %}<li lang="zh-Hans">{{ meta.note }}</li>{% endif %}
  {% if meta.sources_missing and meta.sources_missing.length %}
  <li>Missing sources: {{ meta.sources_missing | join(", ") }}</li>
  {% endif %}
</ul>
{% else %}
<p>Nothing in this section.</p>
{% endif %}
