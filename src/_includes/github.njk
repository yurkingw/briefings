{% import "macros.njk" as ui with context %}
{% set gh = briefing.github if briefing.github else {} %}
{% set rising = gh.rising if gh.rising else [] %}
{% set newcomers = gh.newcomers if gh.newcomers else [] %}
{% set summary = gh.meta | summaryView %}
{% set risingInsight = rising | boardInsight(gh.meta, "rising") %}
{% set newInsight = newcomers | boardInsight(gh.meta, "newcomers") %}

<div class="sub-tabs seg" role="tablist" aria-label="GitHub">
  <button type="button" role="tab" id="tab-gh-rising" aria-controls="gh-rising" aria-selected="true" tabindex="0">{{ labels.trending }}</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-gh-newcomers" aria-controls="gh-newcomers" aria-selected="false" tabindex="-1">{{ labels.newcomers }}</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-gh-summary" aria-controls="gh-summary" aria-selected="false" tabindex="-1">{{ labels.summary }}</button>
</div>

{% macro repoRows(items, kind) %}
<ol class="brf-rows">
  {% for item in items %}
  {% set status = item | statusParts %}
  <li>
    <a class="brf-row hit-row" href="#gh-{{ kind }}-{{ item.rank }}">
      <span class="brf-row-lead">{{ item.rank | rankLabel }}</span>
      <span class="brf-row-title">{{ item.repo }}</span>
      <span class="brf-row-detail" lang="zh-Hans">{% if item.slogan %}{{ item.slogan }}{% else %}—{% endif %}</span>
      <span class="brf-row-meta"{% if item | githubMetaLine(kind) | textLang %} lang="zh-Hans"{% endif %}>{{ item | githubMetaLine(kind) }}</span>
      <span class="brf-row-status">
        <span class="brf-status">{{ status.who }}</span>
        {% if status.break %}<span class="brf-status" data-tone="danger"{% if status.break | textLang %} lang="zh-Hans"{% endif %}>{{ status.break }}</span>{% endif %}
      </span>
    </a>
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{% macro repoDetails(items, kind) %}
<div class="gh-details">
  {% for item in items %}
  {% set status = item | statusParts %}
  <article class="gh-detail" id="gh-{{ kind }}-{{ item.rank }}">
    <p class="brf-status-row">
      <span class="brf-status">{{ status.who }}</span>
      {% if status.break %}<span class="brf-status" data-tone="danger"{% if status.break | textLang %} lang="zh-Hans"{% endif %}>{{ status.break }}</span>{% endif %}
    </p>
    <h3>#{{ item.rank }} · <span class="detail-title">{{ item.repo }}</span></h3>
    <dl class="brf-properties">
      <div class="brf-properties-row"><dt>{{ labels.what }}</dt><dd{% if (item.what or item.slogan) | textLang %} lang="zh-Hans"{% endif %}>{% if item.what %}{{ item.what }}{% elif item.slogan %}{{ item.slogan }}{% else %}—{% endif %}</dd></div>
      <div class="brf-properties-row"><dt>{{ labels.whyItRose }}</dt><dd{% if item.why | textLang %} lang="zh-Hans"{% endif %}>{% if item.why %}{{ item.why }}{% else %}—{% endif %}</dd></div>
      <div class="brf-properties-row"><dt>{{ labels.windowDelta }}</dt><dd>{{ item | ghWindowValue(kind) }}</dd></div>
      <div class="brf-properties-row"><dt>{{ labels.stars }}</dt><dd>{% if item.stars == null %}—{% else %}{{ item.stars }}{% endif %}</dd></div>
      <div class="brf-properties-row"><dt>{{ labels.launched }}</dt><dd{% if item | ghSeenValue | textLang %} lang="zh-Hans"{% endif %}>{{ item | ghSeenValue }}</dd></div>
      <div class="brf-properties-row"><dt>{{ labels.links }}</dt><dd>{% if item.url %}<a href="{{ item.url }}" title="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.url }}</a>{% else %}—{% endif %}</dd></div>
    </dl>
  </article>
  {% endfor %}
</div>
{% endmacro %}

{% macro repoRest(items, kind) %}
{% if items.length %}
<section class="block">
  <h2>{{ labels.otherRepos }}</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">{{ labels.shortName }}</th>
          <th scope="col">Slogan</th>
          <th scope="col">+N</th>
          <th scope="col">{{ labels.stars }}</th>
          <th scope="col">{{ labels.links }}</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
        <tr>
          <td data-label="#">{{ item.rank }}</td>
          <td class="col-short" data-label="{{ labels.shortName }}"><span class="cell-short" title="{{ item.repo }}">{{ item.repo }}</span></td>
          <td data-label="Slogan"{% if item.slogan | textLang %} lang="zh-Hans"{% endif %}>{% if item.slogan %}{{ item.slogan }}{% else %}—{% endif %}</td>
          <td data-label="+N">{{ item | ghWindowValue(kind) }}</td>
          <td data-label="{{ labels.stars }}">{% if item.stars == null %}—{% else %}{{ item.stars }}{% endif %}</td>
          <td data-label="{{ labels.links }}">{% if item.url %}{{ ui.cellLinks([item.url]) }}{% else %}—{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}
{% endmacro %}

{% set risingLead = rising | takeFeatured(5) %}
{% set risingRest = rising | takeRest(5) %}
{% set newLead = newcomers | takeFeatured(5) %}
{% set newRest = newcomers | takeRest(5) %}
{% set ghLead = labels.today if briefing.date else labels.thisWeek %}

<div class="sub-panel" id="gh-rising" role="tabpanel" aria-labelledby="tab-gh-rising">
  {% if rising.length %}
  {% if risingInsight %}{{ ui.callout(ghLead, risingInsight, "info", risingInsight | textLang) }}{% endif %}
  {{ repoRows(risingLead, "rising") }}
  {{ repoDetails(risingLead, "rising") }}
  {{ repoRest(risingRest, "rising") }}
  {% else %}
  <p class="empty">{{ labels.noEntries }}</p>
  {% endif %}
</div>

<div class="sub-panel" id="gh-newcomers" role="tabpanel" aria-labelledby="tab-gh-newcomers" hidden inert>
  {% if newcomers.length %}
  {% if newInsight %}{{ ui.callout(ghLead, newInsight, "info", newInsight | textLang) }}{% endif %}
  {{ repoRows(newLead, "newcomer") }}
  {{ repoDetails(newLead, "newcomer") }}
  {{ repoRest(newRest, "newcomers") }}
  {% else %}
  <p class="empty">{{ labels.noEntries }}</p>
  {% endif %}
</div>

<div class="sub-panel summary" id="gh-summary" role="tabpanel" aria-labelledby="tab-gh-summary" hidden inert>
  {% if summary.lines.length %}
  <ol class="gh-summary-list">
    {% for line in summary.lines %}
    <li lang="zh-Hans">{{ line }}</li>
    {% endfor %}
  </ol>
  {% endif %}
  {% if summary.calib %}
  {{ ui.callout(labels.basis, summary.calib, "info", summary.calib | textLang) }}
  {% endif %}
  {% if not summary.lines.length and not summary.calib %}
  <p class="empty">{{ labels.noEntries }}</p>
  {% endif %}
</div>
