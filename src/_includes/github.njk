{% import "macros.njk" as ui %}
{% set gh = briefing.github if briefing.github else {} %}
{% set rising = gh.rising if gh.rising else [] %}
{% set newcomers = gh.newcomers if gh.newcomers else [] %}
{% set summary = gh.meta | summaryView %}
{% set risingInsight = rising | boardInsight(gh.meta, "rising") %}
{% set newInsight = newcomers | boardInsight(gh.meta, "newcomers") %}

<div class="sub-tabs seg" role="tablist" aria-label="GitHub">
  <button type="button" role="tab" id="tab-gh-rising" aria-controls="gh-rising" aria-selected="true" tabindex="0">涨星榜</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-gh-newcomers" aria-controls="gh-newcomers" aria-selected="false" tabindex="-1">新锐榜</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-gh-summary" aria-controls="gh-summary" aria-selected="false" tabindex="-1">总结</button>
</div>

{% macro repoRows(items, kind) %}
<ol class="brf-rows">
  {% for item in items %}
  {% set status = item | statusParts %}
  <li>
    <a class="brf-row hit-row" href="#gh-{{ kind }}-{{ item.rank }}">
      <span class="brf-row-lead">{{ item.rank | rankLabel }}</span>
      <span class="brf-row-title">{{ item.repo }}</span>
      <span class="brf-row-detail" lang="zh-Hans">{% if item.slogan %}{{ item.slogan }}{% else %}—{% endif %}</span>
      <span class="brf-row-meta">{{ item | githubMetaLine(kind) }}</span>
      <span class="brf-row-status">
        <span class="brf-status">{{ status.who }}</span>
        {% if status.break %}<span class="brf-status" data-tone="danger">{{ status.break }}</span>{% endif %}
      </span>
    </a>
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{% macro repoDetails(items, kind, whyLead) %}
<div class="gh-details">
  {% for item in items %}
  {% set status = item | statusParts %}
  <article class="gh-detail" id="gh-{{ kind }}-{{ item.rank }}">
    <p class="brf-status-row">
      <span class="brf-status">{{ status.who }}</span>
      {% if status.break %}<span class="brf-status" data-tone="danger">{{ status.break }}</span>{% endif %}
    </p>
    <h3>{{ item.repo }}</h3>
    {% if item.slogan %}<p class="brf-row-detail" lang="zh-Hans">{{ item.slogan }}</p>{% endif %}
    <dl class="brf-metrics">
      {% for metric in item | githubMetrics(kind) %}
      <div>
        <dt>{{ metric.label }}</dt>
        <dd>{{ metric.value }}</dd>
      </div>
      {% endfor %}
    </dl>
    {% if item.what %}
    {{ ui.callout("是什么", item.what, "info") }}
    {% endif %}
    {% if item.why %}
    {{ ui.callout(whyLead, item.why, "info") }}
    {% endif %}
    {% if item.url %}
    <p class="gh-url"><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.url }}</a></p>
    {% endif %}
  </article>
  {% endfor %}
</div>
{% endmacro %}

<div class="sub-panel" id="gh-rising" role="tabpanel" aria-labelledby="tab-gh-rising">
  {% if rising.length %}
  {% if risingInsight %}{{ ui.callout("今日看点", risingInsight, "info") }}{% endif %}
  {{ repoRows(rising, "rising") }}
  {{ repoDetails(rising, "rising", "为什么涨") }}
  {% else %}
  <p class="empty">本榜无条目。</p>
  {% endif %}
</div>

<div class="sub-panel" id="gh-newcomers" role="tabpanel" aria-labelledby="tab-gh-newcomers" hidden inert>
  {% if newcomers.length %}
  {% if newInsight %}{{ ui.callout("今日看点", newInsight, "info") }}{% endif %}
  {{ repoRows(newcomers, "newcomer") }}
  {{ repoDetails(newcomers, "newcomer", "为什么新锐") }}
  {% else %}
  <p class="empty">本榜无条目。</p>
  {% endif %}
</div>

<div class="sub-panel summary" id="gh-summary" role="tabpanel" aria-labelledby="tab-gh-summary" hidden inert>
  {% if summary.lines.length %}
  <ol class="gh-summary-list">
    {% for line in summary.lines %}
    <li lang="zh-Hans">{{ line }}</li>
    {% endfor %}
  </ol>
  {% endif %}
  {% if summary.calib %}
  {{ ui.callout("口径", summary.calib, "info") }}
  {% endif %}
  {% if not summary.lines.length and not summary.calib %}
  <p class="empty">本榜无条目。</p>
  {% endif %}
</div>
