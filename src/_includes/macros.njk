{% macro linkList(links) %}
<ul class="link-list">
  {%- for link in links %}
  <li><a href="{{ link }}" title="{{ link }}" target="_blank" rel="noopener noreferrer">{{ link | linkLabel }}</a></li>
  {%- endfor %}
</ul>
{% endmacro %}

{% macro cellLinks(links) %}
{%- if links and links.length -%}
<div class="cell-links">
  {%- for link in links -%}
  <a href="{{ link }}" title="{{ link }}" target="_blank" rel="noopener noreferrer">{{ link | linkLabel }}</a>
  {%- endfor -%}
</div>
{%- else -%}—{%- endif -%}
{% endmacro %}

{% macro properties(rows) %}
<dl class="brf-properties">
  {%- for row in rows %}
  <div class="brf-properties-row">
    <dt>{{ row.label }}</dt>
    <dd lang="zh-Hans">{{ row.value }}</dd>
  </div>
  {%- endfor %}
</dl>
{% endmacro %}

{% macro callout(lead, body, tone) %}
<div class="brf-callout" data-tone="{{ tone or "info" }}">
  <p class="brf-callout-lead">{{ lead }}</p>
  <p class="brf-callout-body" lang="zh-Hans">{{ body }}</p>
</div>
{% endmacro %}

{% macro columnTabs(isDaily, suffix) %}
<div class="page-tabs{% if suffix %} page-tabs-bottom{% endif %} seg" role="tablist" aria-label="栏目" data-tab-group="columns">
  <button type="button" role="tab" id="tab-news{{ suffix }}" aria-controls="panel-news" aria-selected="true" tabindex="0">要闻</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-papers{{ suffix }}" aria-controls="panel-papers" aria-selected="false" tabindex="-1">顶尖论文</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-github{{ suffix }}" aria-controls="panel-github" aria-selected="false" tabindex="-1">GitHub</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  {% if isDaily %}
  <button type="button" role="tab" id="tab-appendix{{ suffix }}" aria-controls="panel-appendix" aria-selected="false" tabindex="-1">附录</button>
  {% else %}
  <button type="button" role="tab" id="tab-decisions{{ suffix }}" aria-controls="panel-decisions" aria-selected="false" tabindex="-1">金融决策</button>
  {% endif %}
</div>
{% endmacro %}

{% macro linkCards(sources) %}
{% if sources and sources.length %}
<ul class="brf-link-cards">
  {% for source in sources %}
  <li class="brf-link-card">
    <p class="brf-link-card-title" lang="zh-Hans">{{ source }}</p>
    <p class="brf-link-card-meta">公开来源</p>
  </li>
  {% endfor %}
</ul>
{% endif %}
{% endmacro %}

{% macro hotJump(item) %}
<li><a class="hot-jump hit-row" href="{{ item.href }}">{% if item.n != null %}<span class="hot-index">{{ item.n }}</span>{% endif %}<span class="hot-title" lang="zh-Hans">{{ item.title }}</span></a></li>
{% endmacro %}

{% macro detailCard(item) %}
<article class="detail-card" id="note-{{ item.id }}">
  <h3 class="card-title" lang="zh-Hans">#{{ item.id }} · {{ item.domain }} · {{ item | displayTitle }}</h3>
  {% if item.finsec === true or item.hard_gate === true %}
  <p class="brf-status-row">
    {% if item.finsec === true %}<span class="brf-status">finsec</span>{% endif %}
    {% if item.hard_gate === true %}<span class="brf-status" data-tone="danger">硬门槛</span>{% endif %}
  </p>
  {% endif %}
  <dl class="brf-properties">
    {% if item.background %}
    <div class="brf-properties-row"><dt>背景</dt><dd lang="zh-Hans">{{ item.background }}</dd></div>
    {% endif %}
    {% if item.facts %}
    <div class="brf-properties-row"><dt>事实</dt><dd lang="zh-Hans">{{ item.facts }}</dd></div>
    {% endif %}
    {% if item.why %}
    <div class="brf-properties-row"><dt>为何重要</dt><dd lang="zh-Hans">{{ item.why }}</dd></div>
    {% endif %}
    {% if item.arch_impact %}
    <div class="brf-properties-row"><dt>架构冲击</dt><dd lang="zh-Hans">{{ item.arch_impact }}</dd></div>
    {% endif %}
    {% if item.channel %}
    <div class="brf-properties-row"><dt>通路</dt><dd lang="zh-Hans">{{ item.channel }}</dd></div>
    {% endif %}
    {% if item.first_source_at %}
    <div class="brf-properties-row"><dt>最早来源·时间</dt><dd lang="zh-Hans">{{ item.first_source_at }}</dd></div>
    {% endif %}
    {% if item.links and item.links.length %}
    <div class="brf-properties-row"><dt>链接</dt><dd>{{ linkList(item.links) }}</dd></div>
    {% endif %}
  </dl>
</article>
{% endmacro %}

{% macro newsDaily(items, primary, key) %}
{% set hot = items | hotFromItems %}
{% set cards = items | detailCards %}
{% set rest = items | remainderNews %}
{% if hot.length %}
<section class="block hot-picks" id="{{ "hot" if primary else "hot-" + key }}" aria-labelledby="{{ "hot-heading" if primary else "hot-heading-" + key }}">
  <h2 id="{{ "hot-heading" if primary else "hot-heading-" + key }}">本波最热</h2>
  <ol class="hot hot-list">
    {% for item in hot %}
    {{ hotJump(item) }}
    {% endfor %}
  </ol>
</section>
{% endif %}
{% if cards.length %}
<div class="detail-cards">
  {% for item in cards %}
  {{ detailCard(item) }}
  {% endfor %}
</div>
{% endif %}
{% if rest.length %}
<section class="block" id="{{ "remainder" if primary else "remainder-" + key }}">
  <h2>其余要点</h2>
  <div class="table-wrap">
    <table class="rest">
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">领域</th>
          <th scope="col">标题</th>
          <th scope="col">通路</th>
          <th scope="col">最早源时</th>
          <th scope="col">链接</th>
        </tr>
      </thead>
      <tbody>
        {% for item in rest %}
        <tr>
          <td data-label="#">{{ item.id }}</td>
          <td data-label="领域" lang="zh-Hans">{{ item.domain }}</td>
          <td class="col-title" data-label="标题" lang="zh-Hans">
            <span class="cell-title">{{ item | displayTitle }}</span>
            {% if item.finsec === true or item.hard_gate === true %}
            <span class="brf-status-row">
              {% if item.finsec === true %}<span class="brf-status">finsec</span>{% endif %}
              {% if item.hard_gate === true %}<span class="brf-status" data-tone="danger">硬门槛</span>{% endif %}
            </span>
            {% endif %}
          </td>
          <td data-label="通路" lang="zh-Hans">{% if item.channel %}{{ item.channel }}{% else %}—{% endif %}</td>
          <td data-label="最早源时" lang="zh-Hans">{% if item.first_source_at %}{{ item.first_source_at }}{% else %}—{% endif %}</td>
          <td data-label="链接">{{ cellLinks(item.links) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}
{% if not hot.length and not cards.length and not rest.length %}
<p class="empty">本波无要闻。</p>
{% endif %}
{% endmacro %}
