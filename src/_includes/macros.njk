{% macro linkList(links) %}
{% set views = links | linkViews %}
<ul class="link-list">
  {%- for view in views %}
  <li><a href="{{ view.href }}" title="{{ view.title }}" target="_blank" rel="noopener noreferrer">{{ view.label }}</a></li>
  {%- endfor %}
</ul>
{% endmacro %}

{% macro cellLinks(links) %}
{% set views = links | linkViews %}
{%- if views and views.length -%}
<div class="cell-links">
  <a class="cell-link" href="{{ views[0].href }}" title="{{ views[0].title }}" target="_blank" rel="noopener noreferrer">{{ views[0].label }}</a>
  {%- if views.length > 1 -%}
  <span class="cell-more" title="{{ views.length - 1 }}">+{{ views.length - 1 }}</span>
  {%- endif -%}
</div>
{%- else -%}—{%- endif -%}
{% endmacro %}

{% macro properties(rows) %}
<dl class="brf-properties">
  {%- for row in rows %}
  <div class="brf-properties-row">
    <dt>{{ row.label }}</dt>
    <dd{% if row.value | textLang %} lang="zh-Hans"{% endif %}>{{ row.value }}</dd>
  </div>
  {%- endfor %}
</dl>
{% endmacro %}

{% macro callout(lead, body, tone, bodyLang) %}
<div class="brf-callout" data-tone="{{ tone or "info" }}">
  <p class="brf-callout-lead">{{ lead }}</p>
  <p class="brf-callout-body"{% if bodyLang %} lang="{{ bodyLang }}"{% endif %}>{{ body }}</p>
</div>
{% endmacro %}

{% macro columnTabs(isDaily, suffix) %}
<div class="page-tabs{% if suffix %} page-tabs-bottom{% endif %} seg" role="tablist" aria-label="{{ labels.sections }}" data-tab-group="columns">
  <button type="button" role="tab" id="tab-news{{ suffix }}" data-tab="news" title="{{ labels.news }}" aria-controls="panel-news" aria-selected="true" tabindex="0">{{ labels.news }}</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-polfin{{ suffix }}" data-tab="polfin" title="{{ labels.polfin }}" aria-controls="panel-polfin" aria-selected="false" tabindex="-1">{{ labels.polfin }}</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-papers{{ suffix }}" data-tab="papers" title="{{ labels.papers }}" aria-controls="panel-papers" aria-selected="false" tabindex="-1">{{ labels.papers }}</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  <button type="button" role="tab" id="tab-github{{ suffix }}" data-tab="github" title="GitHub" aria-controls="panel-github" aria-selected="false" tabindex="-1">GitHub</button>
  <span class="seg-gap" aria-hidden="true">·</span>
  {% if isDaily %}
  <button type="button" role="tab" id="tab-appendix{{ suffix }}" data-tab="appendix" title="{{ labels.appendix }}" aria-controls="panel-appendix" aria-selected="false" tabindex="-1">{{ labels.appendix }}</button>
  {% else %}
  <button type="button" role="tab" id="tab-decisions{{ suffix }}" data-tab="findec" title="{{ labels.financialDecisions }}" aria-controls="panel-decisions" aria-selected="false" tabindex="-1">{{ labels.financialDecisions }}</button>
  {% endif %}
</div>
{% endmacro %}

{% macro linkCards(sources) %}
{% if sources and sources.length %}
<ul class="brf-link-cards">
  {% for source in sources %}
  <li class="brf-link-card">
    <p class="brf-link-card-title" lang="zh-Hans">{{ source }}</p>
    <p class="brf-link-card-meta">{{ labels.source }}</p>
  </li>
  {% endfor %}
</ul>
{% endif %}
{% endmacro %}

{% macro hotJump(item) %}
<li><a class="hot-jump hit-row" href="{{ item.href }}">{% if item.n != null %}<span class="hot-index">{{ item.n }}</span>{% endif %}<span class="hot-title" lang="zh-Hans">{{ item.title }}</span></a></li>
{% endmacro %}

{% macro detailCard(item) %}
{% set kick = item | itemKicker %}
{% set kickLang = kick | textLang %}
{% set titleText = item | displayTitle %}
{% set titleLang = titleText | textLang %}
<article class="detail-card" id="note-{{ item.id }}" data-detail-title="{{ titleText }}">
  <h3 class="card-title">#{{ item.id }} · <span{% if kickLang %} lang="{{ kickLang }}"{% endif %}>{{ kick }}</span> · <span class="detail-title"{% if titleLang %} lang="{{ titleLang }}"{% endif %}>{{ titleText }}</span></h3>
  {% if item.finsec === true or item.hard_gate === true %}
  <p class="brf-status-row">
    {% if item.finsec === true %}<span class="brf-status">finsec</span>{% endif %}
    {% if item.hard_gate === true %}<span class="brf-status" data-tone="danger">{{ labels.hardGate }}</span>{% endif %}
  </p>
  {% endif %}
  <dl class="brf-properties">
    {% if item.background %}
    <div class="brf-properties-row"><dt>{{ labels.background }}</dt><dd lang="zh-Hans">{{ item.background }}</dd></div>
    {% endif %}
    {% if item.facts %}
    <div class="brf-properties-row"><dt>{{ labels.facts }}</dt><dd lang="zh-Hans">{{ item.facts }}</dd></div>
    {% endif %}
    {% if item.why %}
    <div class="brf-properties-row"><dt>{{ labels.whyItMatters }}</dt><dd lang="zh-Hans">{{ item.why }}</dd></div>
    {% endif %}
    {% if item.arch_impact %}
    <div class="brf-properties-row"><dt>{{ labels.architectureImpact }}</dt><dd lang="zh-Hans">{{ item.arch_impact }}</dd></div>
    {% endif %}
    {% if item.channel %}
    <div class="brf-properties-row"><dt>{{ labels.channel }}</dt><dd lang="zh-Hans">{{ item.channel }}</dd></div>
    {% endif %}
    {% if item.first_source_at %}
    <div class="brf-properties-row"><dt>{{ labels.firstSeen }}</dt><dd lang="zh-Hans">{{ item.first_source_at }}</dd></div>
    {% endif %}
    {% if item.links and item.links.length %}
    <div class="brf-properties-row"><dt>{{ labels.links }}</dt><dd>{{ linkList(item.links) }}</dd></div>
    {% endif %}
  </dl>
</article>
{% endmacro %}

{% macro newsDaily(items, primary, key, lane) %}
{% set hot = items | hotFromItems %}
{% set cards = items | detailCards %}
{% set rest = items | remainderNews %}
{% if hot.length %}
<section class="block hot-picks" id="{{ "hot" if primary else "hot-" + key }}" aria-labelledby="{{ "hot-heading" if primary else "hot-heading-" + key }}">
  <h2 id="{{ "hot-heading" if primary else "hot-heading-" + key }}">{{ labels.hotThisWave }}</h2>
  <ol class="hot hot-list">
    {% for item in hot %}
    {{ hotJump(item) }}
    {% endfor %}
  </ol>
</section>
{% endif %}
{% if cards.length %}
<div class="detail-cards">
  {% for item in cards %}
  {{ detailCard(item) }}
  {% endfor %}
</div>
{% endif %}
{% if rest.length %}
<section class="block" id="{{ "remainder" if primary else "remainder-" + key }}">
  <h2>{{ labels.otherPoints }}</h2>
  <div class="table-wrap">
    <table class="rest">
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">{% if lane == "polfin" %}{{ labels.angle }}{% else %}{{ labels.domain }}{% endif %}</th>
          <th scope="col">{{ labels.title }}</th>
          <th scope="col">{{ labels.channel }}</th>
          <th scope="col">{{ labels.firstSeen }}</th>
          <th scope="col">{{ labels.links }}</th>
        </tr>
      </thead>
      <tbody>
        {% for item in rest %}
        <tr>
          <td data-label="#">{{ item.id }}</td>
          <td data-label="{% if lane == "polfin" %}{{ labels.angle }}{% else %}{{ labels.domain }}{% endif %}"{% set kick = item | itemKicker %}{% set kickLang = kick | textLang %}{% if kickLang %} lang="{{ kickLang }}"{% endif %}>{{ kick }}</td>
          <td class="col-title" data-label="{{ labels.title }}"{% set rowTitle = item | displayTitle %}{% set rowLang = rowTitle | textLang %}{% if rowLang %} lang="{{ rowLang }}"{% endif %}>
            <span class="cell-short is-title">{{ rowTitle }}</span>
            {% if item.finsec === true or item.hard_gate === true %}
            <span class="brf-status-row">
              {% if item.finsec === true %}<span class="brf-status">finsec</span>{% endif %}
              {% if item.hard_gate === true %}<span class="brf-status" data-tone="danger">{{ labels.hardGate }}</span>{% endif %}
            </span>
            {% endif %}
          </td>
          <td data-label="{{ labels.channel }}"{% if item.channel | textLang %} lang="zh-Hans"{% endif %}>{% if item.channel %}{{ item.channel }}{% else %}—{% endif %}</td>
          <td data-label="{{ labels.firstSeen }}"{% if item.first_source_at | textLang %} lang="zh-Hans"{% endif %}>{% if item.first_source_at %}{{ item.first_source_at }}{% else %}—{% endif %}</td>
          <td data-label="{{ labels.links }}">{{ cellLinks(item.links) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}
{% if not hot.length and not cards.length and not rest.length %}
<p class="empty">{{ labels.noEntries }}</p>
{% endif %}
{% endmacro %}
