<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <script>
    (function () {
      document.documentElement.classList.add("js");
      try {
        var mode = localStorage.getItem("brf-theme");
        if (mode === "day" || mode === "night") {
          document.documentElement.setAttribute("data-theme", mode);
        }
      } catch (e) {}
    })();
  </script>
  {% if briefing and briefing.date %}
  <title>Daily {{ briefing.date }} · {{ site.name }}</title>
  {% elif briefing and briefing.week %}
  <title>Weekly {{ briefing.week }} · {{ site.name }}</title>
  {% else %}
  <title>{{ site.name }}</title>
  {% endif %}
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  {% if briefing and briefing.schema %}
  <meta name="briefing-schema" content="{{ briefing.schema }}">
  {% endif %}
  {% if briefing and briefing.summary %}
  <meta name="description" content="{{ briefing.summary }}">
  {% else %}
  <meta name="description" content="Public mirror of daily and weekly briefings. The in-chat Canvas remains authoritative.">
  {% endif %}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%230a0a0a'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body class="{% if briefing %}is-briefing{% else %}is-home{% endif %}">
  <header class="chrome">
    <div class="top">
      <div class="top-inner">
        <div class="brand-lockup">
          <a class="root-link" href="{{ site.origin }}/">Home</a>
          <span class="brand-gap" aria-hidden="true">·</span>
          <a class="brand" href="/">{{ site.name }}</a>
        </div>
        <nav class="nav" aria-label="Sections">
          <a href="/#daily"{% if briefing and briefing.date %} aria-current="page"{% endif %}>Daily</a>
          <a href="/#weekly"{% if briefing and briefing.week %} aria-current="page"{% endif %}>Weekly</a>
        </nav>
        <div class="seg theme-switch" role="group" aria-label="Color theme">
          <button type="button" data-theme-set="system" aria-pressed="true">Auto</button>
          <span class="seg-gap" aria-hidden="true">·</span>
          <button type="button" data-theme-set="day" aria-pressed="false">Day</button>
          <span class="seg-gap" aria-hidden="true">·</span>
          <button type="button" data-theme-set="night" aria-pressed="false">Night</button>
        </div>
      </div>
    </div>
    <p class="mirror">Public mirror. The briefing in chat (Canvas) remains authoritative.</p>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-foot">
    <div class="site-foot-inner">
      {% if briefing %}
      <p><a href="/">Index</a></p>
      {% endif %}
      <p>Independent mirror. Sources stay with their authors.</p>
      <p><a href="{{ site.baseUrl }}/">{{ site.baseUrl }}/</a></p>
    </div>
  </footer>
  {% if briefing %}
  <button type="button" class="back-to-top" hidden>Top</button>
  {% endif %}
  <script>
    (function () {
      var root = document.documentElement;
      var storageKey = "brf-theme";
      var buttons = document.querySelectorAll(".theme-switch button[data-theme-set]");
      function read() {
        try {
          var mode = localStorage.getItem(storageKey);
          if (mode === "day" || mode === "night" || mode === "system") return mode;
        } catch (e) {}
        return "system";
      }
      function apply(mode, persist) {
        if (mode === "day" || mode === "night") root.setAttribute("data-theme", mode);
        else root.removeAttribute("data-theme");
        buttons.forEach(function (button) {
          button.setAttribute("aria-pressed", button.getAttribute("data-theme-set") === mode ? "true" : "false");
        });
        if (persist) {
          try { localStorage.setItem(storageKey, mode); } catch (e) {}
        }
      }
      apply(read(), false);
      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          apply(button.getAttribute("data-theme-set"), true);
        });
      });

      var motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      function scrollBehavior() {
        return motionQuery.matches ? "auto" : "smooth";
      }
      function selectTab(tab) {
        var controls = tab.getAttribute("aria-controls");
        var list = tab.closest('[role="tablist"]');
        if (!list || !controls) return;
        var group = list.getAttribute("data-tab-group");
        var lists = group
          ? document.querySelectorAll('[role="tablist"][data-tab-group="' + group + '"]')
          : [list];
        lists.forEach(function (bar) {
          bar.querySelectorAll('[role="tab"]').forEach(function (btn) {
            var on = btn.getAttribute("aria-controls") === controls;
            btn.setAttribute("aria-selected", on ? "true" : "false");
            btn.setAttribute("tabindex", on ? "0" : "-1");
          });
        });
        var touched = {};
        lists.forEach(function (bar) {
          bar.querySelectorAll('[role="tab"]').forEach(function (btn) {
            var panelId = btn.getAttribute("aria-controls");
            if (!panelId || touched[panelId]) return;
            touched[panelId] = true;
            var panel = document.getElementById(panelId);
            if (!panel) return;
            var on = panelId === controls;
            if (on) {
              panel.removeAttribute("hidden");
              panel.removeAttribute("inert");
              if (!motionQuery.matches) {
                panel.classList.remove("is-live");
                void panel.offsetWidth;
                panel.classList.add("is-live");
              }
            } else {
              panel.setAttribute("hidden", "");
              panel.setAttribute("inert", "");
              panel.classList.remove("is-live");
            }
          });
        });
      }
      document.querySelectorAll('[role="tab"]').forEach(function (tab) {
        tab.addEventListener("click", function () { selectTab(tab); });
      });
      function revealTarget(target) {
        var panels = [];
        var node = target;
        while (node && node !== document.body) {
          if (node.getAttribute && node.getAttribute("role") === "tabpanel" && node.id) panels.push(node);
          node = node.parentElement;
        }
        panels.reverse().forEach(function (panel) {
          var tab = document.querySelector('[aria-controls="' + panel.id + '"]');
          if (tab) selectTab(tab);
        });
      }
      if (location.hash && location.hash.length > 1) {
        var initial = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (initial) revealTarget(initial);
      }
      document.querySelectorAll('a[href^="#"]').forEach(function (link) {
        link.addEventListener("click", function (event) {
          var href = link.getAttribute("href");
          if (!href || href.length < 2) return;
          var id = decodeURIComponent(href.slice(1));
          var target = document.getElementById(id);
          if (!target) return;
          event.preventDefault();
          revealTarget(target);
          target.scrollIntoView({ behavior: scrollBehavior(), block: "start" });
          if (history.replaceState) history.replaceState(null, "", "#" + id);
        });
      });
      document.querySelectorAll("[data-scroll]").forEach(function (button) {
        button.addEventListener("click", function () {
          var id = button.getAttribute("data-scroll");
          var target = id && document.getElementById(id);
          if (!target) return;
          target.scrollIntoView({ behavior: scrollBehavior(), block: "start" });
          if (history.replaceState) history.replaceState(null, "", "#" + id);
        });
      });
      var topButton = document.querySelector("button.back-to-top");
      if (topButton) {
        function syncTop() {
          var y = window.scrollY || document.documentElement.scrollTop || 0;
          var show = y >= (window.innerHeight || 1) * 2;
          if (show) topButton.removeAttribute("hidden");
          else topButton.setAttribute("hidden", "");
        }
        syncTop();
        window.addEventListener("scroll", syncTop, { passive: true });
        topButton.addEventListener("click", function () {
          document.documentElement.scrollIntoView({ behavior: scrollBehavior(), block: "start" });
          if (history.replaceState) {
            history.replaceState(null, "", window.location.pathname + window.location.search);
          }
        });
      }
    })();
  </script>
</body>
</html>
