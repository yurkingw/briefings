---
layout: base.njk
permalink: /
---

<h1>Briefings</h1>
<p>Public mirror of daily and weekly intelligence briefings. Navigation is English. Briefing text stays in its original language.</p>

<h2 id="daily">Daily</h2>
{% if briefings.daily.length %}
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Wave</th>
        <th>Conclusion</th>
      </tr>
    </thead>
    <tbody>
      {% for item in briefings.daily %}
      <tr>
        <td><a href="/daily/{{ item.date }}/">{{ item.date }}</a>{% if item.sample %} · Sample{% endif %}</td>
        <td lang="zh-Hans">{{ item.wave }}</td>
        <td lang="zh-Hans">{{ item.summary }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p>No daily briefings yet.</p>
{% endif %}

<h2 id="weekly">Weekly</h2>
{% if briefings.weekly.length %}
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Week</th>
        <th>Conclusion</th>
      </tr>
    </thead>
    <tbody>
      {% for item in briefings.weekly %}
      <tr>
        <td><a href="/weekly/{{ item.week }}/">{{ item.week }}</a>{% if item.sample %} · Sample{% endif %}</td>
        <td lang="zh-Hans">{{ item.summary }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p>No weekly briefings yet.</p>
{% endif %}
