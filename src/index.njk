---
layout: base.njk
permalink: /
---

{% macro dailyRow(item, title, metaLabel) %}
<a class="entry hit-row" href="/daily/{{ item.date }}/">
  <span class="entry-head">
    <span class="entry-title">{{ title }}</span>
    <span class="entry-go" aria-hidden="true">→</span>
  </span>
  <span class="entry-blurb" lang="zh-Hans">{{ item.summary | excerpt(150) }}</span>
  {% if metaLabel or item.wave or item.sample %}
  <span class="entry-meta">{%- if metaLabel -%}{{ metaLabel }}{%- endif -%}{% if metaLabel and item.wave %} · {% endif %}{%- if item.wave -%}<span lang="zh-Hans">{{ item.wave }}</span>{%- endif -%}{% if item.sample %}{% if metaLabel or item.wave %} · {% endif %}Sample{% endif %}</span>
  {% endif %}
</a>
{% endmacro %}

{% macro weeklyRow(item, title, metaLabel) %}
<a class="entry hit-row" href="/weekly/{{ item.week }}/">
  <span class="entry-head">
    <span class="entry-title">{{ title }}</span>
    <span class="entry-go" aria-hidden="true">→</span>
  </span>
  <span class="entry-blurb" lang="zh-Hans">{{ item.summary | excerpt(150) }}</span>
  {% if metaLabel or item.sample %}
  <span class="entry-meta">{%- if metaLabel -%}{{ metaLabel }}{%- endif -%}{% if metaLabel and item.sample %} · {% endif %}{% if item.sample %}Sample{% endif %}</span>
  {% endif %}
</a>
{% endmacro %}

<h1>Briefings</h1>
<p class="lede">Daily and weekly intelligence, mirrored for the public web.</p>

<section class="stage" aria-labelledby="now-heading">
  <h2 id="now-heading">Now</h2>
  {% if stage.daily or stage.weekly %}
  <div class="entries">
    {% if stage.daily %}
    {{ dailyRow(stage.daily, stage.daily.date, "Today") | safe }}
    {% endif %}
    {% if stage.weekly %}
    {{ weeklyRow(stage.weekly, stage.weekly.week, "This week") | safe }}
    {% endif %}
  </div>
  {% endif %}
  {% if not stage.daily and not stage.weekly %}
  <p class="empty">No briefing for today or this week yet.</p>
  {% elif not stage.daily %}
  <p class="empty">No daily briefing for today yet.</p>
  {% elif not stage.weekly %}
  <p class="empty">No weekly briefing for this week yet.</p>
  {% endif %}
</section>

<section class="archive" aria-labelledby="daily">
  <h2 id="daily">Daily</h2>
  {% if briefings.daily.length %}
  <div class="entries" id="daily-archive" data-fold="daily">
    {% for item in briefings.daily %}
    {{ dailyRow(item, item.date, "") | safe }}
    {% endfor %}
  </div>
  {% if briefings.daily.length > 5 %}
  <p class="fold-note">Enable JavaScript to load more.</p>
  {% endif %}
  <button type="button" class="more" aria-controls="daily-archive">More</button>
  {% else %}
  <p class="empty">No briefings published yet.</p>
  {% endif %}
</section>

<section class="archive" aria-labelledby="weekly">
  <h2 id="weekly">Weekly</h2>
  {% if briefings.weekly.length %}
  <div class="entries" id="weekly-archive" data-fold="weekly">
    {% for item in briefings.weekly %}
    {{ weeklyRow(item, item.week, "") | safe }}
    {% endfor %}
  </div>
  {% if briefings.weekly.length > 5 %}
  <p class="fold-note">Enable JavaScript to load more.</p>
  {% endif %}
  <button type="button" class="more" aria-controls="weekly-archive">More</button>
  {% else %}
  <p class="empty">No briefings published yet.</p>
  {% endif %}
</section>
<script type="module" src="/js/fold.js"></script>
