  "decisions": [
    {
      "title": "银行自有账户/出金 API 信任链：Arkéa 官方确认 + CERT-In CRAFTY FALCON",
      "happened": "Arkéa 官方确认遭网络攻击：攻击者使用银行自有账户向他行转账，再可能换成加密资产；客户账户无资金损失；约 $133M/€100M 叙事标 unconfirmed。CERT-In 警告 CRAFTY FALCON 瞄准 BFSI/加密：脆弱应用、暴露测试环境、支付/出金 API。",
      "why": "官方确认升级为银行网络安全事件；监管硬预警把出金 API+预发+共享密钥写成同一失败模式。",
      "arch_impact": "金库/自有账户支付指令、第三方入口、出金 API 与非生产隔离同一控制面。",
      "control_domains": [
        "资金安全",
        "出金/支付 API",
        "第三方平台信任链",
        "预发/测试环境隔离",
        "密钥与凭据治理"
      ],
